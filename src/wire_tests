#include <Arduino.h>
#include <Adafruit_TinyUSB.h>
#include <bluefruit.h>
#include <Wire.h>

void scanBus(TwoWire &bus, const char *name) {
  uint8_t found = 0;

  Serial.println();
  Serial.print("=== Scanning ");
  Serial.print(name);
  Serial.println(" ===");

  for (uint8_t address = 1; address < 127; ++address) {
    bus.beginTransmission(address);
    const uint8_t error = bus.endTransmission();

    if (error == 0) {
      Serial.print("Found device at 0x");
      if (address < 16) {
        Serial.print("0");
      }
      Serial.println(address, HEX);
      ++found;
    }
  }

  if (found == 0) {
    Serial.println("No I2C devices found.");
  }

  Serial.print("Device count: ");
  Serial.println(found);
}

void setup() {
  Serial.begin(9600);

  // Do not use while (!Serial): it can block indefinitely on this PlatformIO/XIAO setup.
  delay(7000);

  Bluefruit.begin(1, 0);
  delay(100);

  pinMode(40, OUTPUT);
  digitalWrite(40, HIGH);
  delay(10);

  Wire.begin();

  Wire1.setClock(100000); // ensure standard 100kHz, not something misconfigured faster
  Wire1.begin();
  delay(100);

  Serial.println();
  Serial.println("Qbead internal-I2C scanner started.");

  pinMode(LED_BUILTIN, OUTPUT);
}

void loop() {
  scanBus(Wire, "Wire (external/default I2C)");
  scanBus(Wire1, "Wire1 (internal XIAO Sense I2C)");
  Serial.println("--------------------------------");

  digitalWrite(LED_BUILTIN, HIGH);
  delay(250);
  digitalWrite(LED_BUILTIN, LOW);
  delay(4750);

  delay(5000);
}